PORT=3001
# e2e jobs run inside the Playwright container — the Postgres service is
# reachable as postgres:5432 on the job network, not via a host-mapped port.
DATABASE_URL=postgresql://motori:motori@postgres:5432/motori
BETTER_AUTH_SECRET=ci-test-secret-not-for-production
BETTER_AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3001
STORAGE_DOCS_BUCKET=motori-docs
