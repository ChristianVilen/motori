<mjml lang="fi">
  <mj-head>
    <mj-title>Motori</mj-title>
    <mj-attributes>
      <mj-all font-family="Instrument Sans, Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.6" color="#15181a" padding="0" />
    </mj-attributes>
    <mj-style inline="inline">
      p { margin: 0 0 16px 0; }
      p:last-child { margin-bottom: 0; }
      a { color: #15181a; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f7f6f2" width="600px">
    <mj-section background-color="#f7f6f2" padding="24px 32px">
      <mj-column>
        <mj-image src="https://motori.fi/wordmark.png" alt="motori" width="85px" align="center" padding="0" />
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="32px 32px 24px">
      <mj-column>
        <mj-text>{{content}}</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#eeede7" padding="16px 32px">
      <mj-column>
        <mj-text align="center" font-size="13px" color="#5a605d" padding="0">
          <a href="https://motori.fi" style="color: #5a605d; text-decoration: none;">motori.fi</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
