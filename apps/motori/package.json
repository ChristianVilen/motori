{
	"name": "motori",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node --env-file-if-exists=.env .output/server/index.mjs",
		"db:migrate": "tsx --env-file-if-exists=.env src/lib/db/migrate.ts",
		"db:seed": "tsx --env-file-if-exists=.env src/lib/db/seed.ts",
		"db:codegen": "tsx --env-file-if-exists=.env src/lib/db/codegen.ts",
		"notify:expiry": "tsx --env-file-if-exists=.env src/lib/notify-expiry.ts",
		"purge:sessions": "tsx --env-file-if-exists=.env src/lib/purge-sessions.ts",
		"images:orphans": "tsx --env-file-if-exists=.env src/lib/images-orphans.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@fontsource-variable/manrope": "5.3.0",
		"@fontsource-variable/space-grotesk": "5.3.0",
		"@fontsource/jetbrains-mono": "5.3.0",
		"@motori/db": "workspace:*",
		"@motori/server": "workspace:*",
		"@motori/ui": "workspace:*",
		"@tanstack/react-form": "1.33.5",
		"@tanstack/react-router": "1.170.45",
		"@tanstack/react-start": "1.169.3",
		"@types/leaflet": "1.9.22",
		"better-auth": "1.7.11",
		"date-fns": "4.4.0",
		"embla-carousel-react": "8.6.0",
		"i18next": "26.5.3",
		"i18next-browser-languagedetector": "8.2.1",
		"kysely": "0.29.7",
		"leaflet": "1.9.4",
		"lucide-react": "1.59.0",
		"nitro": "3.0.260429-beta",
		"pg": "8.23.1",
		"react": "19.3.1",
		"react-day-picker": "10.0.2",
		"react-dom": "19.3.1",
		"react-i18next": "17.1.0",
		"react-leaflet": "5.0.0",
		"sonner": "2.0.8",
		"srvx": "1.0.6",
		"tsx": "4.23.15",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@playwright/test": "1.64.1",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/node": "26.6.5",
		"@types/pg": "8.23.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"jsdom": "30.1.3",
		"kysely-codegen": "0.20.0",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	}
}
