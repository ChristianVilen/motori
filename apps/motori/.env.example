DATABASE_URL=postgresql://motori:motori@localhost:5433/motori

# BetterAuth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3000

# CORS — comma-separated allowed origins (defaults to BETTER_AUTH_URL)
# ALLOWED_ORIGINS=https://motori.fi

# Object storage (Cloudflare R2, S3 API, EU jurisdiction). Leave unset in dev: images
# are then saved under /uploads/ and served from /api/uploads/. When STORAGE_ENDPOINT
# is set, uploads go to the bucket and STORAGE_PUBLIC_URL must serve it.
# Prod values live in secrets/dokku-config.sh (gitignored). Never commit the account id.
# STORAGE_ENDPOINT=https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
# STORAGE_BUCKET=motori-images
# STORAGE_ACCESS_KEY=<motori-app token id>
# STORAGE_SECRET_KEY=<motori-app token secret>
# STORAGE_PUBLIC_URL=https://images.motori.fi

# Resend — leave unset in dev to log emails to stdout instead of sending
# RESEND_API_KEY=re_...

# Optional — pino log level (default: info)
# LOG_LEVEL=debug

# Cron secret — protects /api/cron endpoint
# CRON_SECRET=generate-a-random-string

# --- OpenObserve (optional; logs sink). Leave unset to log only to stdout. ---
# The OO container starts with `docker compose up -d` (and `pnpm dev`); set
# OPENOBSERVE_URL below to make the app actually ship logs to it.
# OPENOBSERVE_URL=http://localhost:5080
# OPENOBSERVE_ORG=default
# OPENOBSERVE_STREAM=motori
# OPENOBSERVE_USER=admin@motori.local
# OPENOBSERVE_PASSWORD=motori
